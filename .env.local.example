# Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://hackathon-heal.onrender.com/api/v1
NEXT_PUBLIC_TAVUS_API_KEY=your-tavus-api-key-here
NEXT_PUBLIC_DAILY_API_KEY=your-daily-api-key-here

# AI Services
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here
NEXT_PUBLIC_ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Backend Security (for Netlify Functions)
JWT_SECRET=your-jwt-secret-here

# Optional: For local development with Netlify Functions
# NEXT_PUBLIC_API_URL=http://localhost:8888/api/v1

# Video session duration in minutes (2-60)
NEXT_PUBLIC_TAVUS_SESSION_MINUTES=5

# Video with Nia (Tavus). Both IDs come from your Tavus dashboard.
# PAL = Nia's conversational video agent (required for video).
NEXT_PUBLIC_TAVUS_PAL_ID=
# Optional: the face/replica to use; leave empty to use the PAL's default face.
NEXT_PUBLIC_TAVUS_FACE_ID=
