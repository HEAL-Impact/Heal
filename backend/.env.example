DATABASE_URL=postgres://postgres:postgres@localhost:5432/heal?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080
ENVIRONMENT=development

# Encrypts reports and case contact details. Required when ENVIRONMENT=production.
REPORT_ENCRYPTION_KEY=

# First partner admin (created on start if no admin exists; password 10+ characters)
PARTNER_ADMIN_EMAIL=
PARTNER_ADMIN_PASSWORD=

# Care alerts to stakeholder WhatsApp groups. Meta's Cloud API cannot post to
# groups, so use a group-capable gateway (e.g. https://gate.whapi.cloud/messages/text).
# Leave empty in development: alerts are printed to the server log.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
HEAL_COORDINATOR_WHATSAPP_GROUP=

# Links inside WhatsApp alerts, and CORS
HEAL_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=
